# ============================================================
# ARCHIVO: .env  (copiar desde .env.example y llenar)
# ============================================================

# App
NODE_ENV=development
PORT=3000
APP_NAME=Nexora API
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_dev
DB_USER=nexora
DB_PASSWORD=nexora_pass
DB_SSL=false
DB_LOGGING=false

# JWT — cambiar en producción
JWT_SECRET=nexora-jwt-secret-cambia-esto-en-produccion-minimo-32-chars
JWT_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Almacenamiento
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Certificados — NUNCA vacío en producción
CERTIFICATE_ENCRYPTION_KEY=nexora-dev-encryption-key-32chars!

# SRI
SRI_ENV=pruebas