# ─── APP ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
API_PREFIX=api/v1
APP_NAME=Nexora API
FRONTEND_URL=https://app.nexora.ec

# ─── BASE DE DATOS ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_prod
DB_USER=nexora
DB_PASSWORD=CAMBIA_ESTO_EN_PRODUCCION
DB_SSL=true
DB_LOGGING=false

# ─── REDIS (para BullMQ) ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIA_ESTO_EN_PRODUCCION

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CAMBIA_ESTO_POR_UN_STRING_ALEATORIO_DE_64_CHARS
JWT_EXPIRATION=7d

# ─── CERTIFICADOS (encriptación) ─────────────────────────────────────────────
# Mínimo 32 caracteres — NUNCA exponer en código
CERTIFICATE_ENCRYPTION_KEY=CAMBIA_ESTO_POR_CLAVE_DE_32_CHARS_MINIMO

# ─── STORAGE ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ─── EMAIL (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-gmail
SMTP_FROM_EMAIL=facturacion@nexora.ec
SMTP_FROM_NAME=Nexora Facturación
