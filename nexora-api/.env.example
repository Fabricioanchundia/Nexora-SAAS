# App
NODE_ENV=development
PORT=3000
APP_NAME=Nexora API
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_dev
DB_USER=nexora
DB_PASSWORD=nexora_pass
DB_SSL=false
DB_LOGGING=false

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (local o S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Si usas S3:
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=nexora-documents
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT=   # Para Cloudflare R2 o DigitalOcean

# Encriptación de certificados .p12 (NUNCA vacío en producción)
CERTIFICATE_ENCRYPTION_KEY=change-this-to-32-char-key-minimum

# SRI (se configura por empresa, esto es fallback global)
SRI_ENV=pruebas

# Email
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Nexora <noreply@nexora.ec>"

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3001